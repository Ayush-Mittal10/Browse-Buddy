# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# --- Which model ---
# anthropic | openai | gemini | ollama | auto
# auto takes the first hosted provider you have a key for (Gemini first,
# since its free tier is the one that costs nobody anything), and falls
# back to the local model when there is no key at all.
# BROWSER_AGENT_PROVIDER=auto

# --- Hosted (Anthropic) ---
ANTHROPIC_API_KEY=
# BROWSER_AGENT_MODEL=claude-opus-5
# BROWSER_AGENT_MAX_TOKENS=8192

# --- Gemini (has a free tier: function calling, no card) ---
GEMINI_API_KEY=
# BROWSER_AGENT_GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI ---
OPENAI_API_KEY=
# BROWSER_AGENT_OPENAI_MODEL=gpt-5.4-mini
# Any OpenAI-compatible endpoint works here.
# BROWSER_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local (Ollama) ---
# BROWSER_AGENT_OLLAMA_MODEL=qwen3:8b
# BROWSER_AGENT_OLLAMA_HOST=http://127.0.0.1:11434
# Every token of this is KV cache held in RAM, whether or not it gets used.
# BROWSER_AGENT_OLLAMA_NUM_CTX=32768
# Thinking costs ~16x the time per step and did not change the answer.
# BROWSER_AGENT_OLLAMA_THINK=false

# --- How much page to show the model ---
# Defaults are 120/3500 for a hosted model, 40/1500 for a local one.
# BROWSER_AGENT_MAX_ELEMENTS=40
# BROWSER_AGENT_MAX_TEXT_CHARS=1500

# --- Agent loop ---
# Model turns allowed per task before it stops and reports progress.
# BROWSER_AGENT_MAX_STEPS=40
# Wall-clock budget for one task, in seconds.
# BROWSER_AGENT_TIMEOUT_S=240
# How many screenshots stay in the conversation history.
# BROWSER_AGENT_MAX_SCREENSHOTS=2

# --- Browser ---
# false shows the browser window so you can watch the run.
# BROWSER_AGENT_HEADLESS=true
# BROWSER_AGENT_VIEWPORT_WIDTH=1280
# BROWSER_AGENT_VIEWPORT_HEIGHT=800
# BROWSER_AGENT_LOCALE=en-US
# BROWSER_AGENT_TIMEZONE=Asia/Kolkata
# BROWSER_AGENT_NAV_TIMEOUT_MS=25000
# BROWSER_AGENT_ACTION_TIMEOUT_MS=8000
# BROWSER_AGENT_SETTLE_MS=700
# BROWSER_AGENT_SNAPSHOT_TIMEOUT_S=12
# BROWSER_AGENT_MAX_WAIT_S=10
# BROWSER_AGENT_SCREENSHOT_QUALITY=55

# --- Serving it to other people ---
# Empty means any public website, which is the default. Regardless of this,
# localhost, the private ranges and the cloud metadata endpoint are always
# refused — that is a separate check and not something this list turns off.
# BROWSER_AGENT_ALLOWED_DOMAINS=wikipedia.org,news.ycombinator.com,bbc.com,python.org
# BROWSER_AGENT_WEB_MAX_SESSIONS=2
# BROWSER_AGENT_WEB_MAX_STEPS=15
# BROWSER_AGENT_WEB_MAX_TASKS=6
# BROWSER_AGENT_WEB_IDLE_TIMEOUT_S=300
# BROWSER_AGENT_WEB_ALLOW_BYOK=true

# --- Storage ---
# Where conversation history is written.
# BROWSER_AGENT_STORE_DIR=~/.browser-agent
