# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# --- LLM ---
ANTHROPIC_API_KEY=
# BROWSER_AGENT_MODEL=claude-opus-5
# BROWSER_AGENT_MAX_TOKENS=8192

# --- Agent loop ---
# Model turns allowed per task before it stops and reports progress.
# BROWSER_AGENT_MAX_STEPS=40
# Wall-clock budget for one task, in seconds.
# BROWSER_AGENT_TIMEOUT_S=240
# How many screenshots stay in the conversation history.
# BROWSER_AGENT_MAX_SCREENSHOTS=2

# --- Browser ---
# false shows the browser window so you can watch the run.
# BROWSER_AGENT_HEADLESS=true
# BROWSER_AGENT_VIEWPORT_WIDTH=1280
# BROWSER_AGENT_VIEWPORT_HEIGHT=800
# BROWSER_AGENT_LOCALE=en-US
# BROWSER_AGENT_TIMEZONE=Asia/Kolkata
# BROWSER_AGENT_NAV_TIMEOUT_MS=25000
# BROWSER_AGENT_ACTION_TIMEOUT_MS=8000
# BROWSER_AGENT_SETTLE_MS=700
# BROWSER_AGENT_SNAPSHOT_TIMEOUT_S=12
# BROWSER_AGENT_MAX_WAIT_S=10
# BROWSER_AGENT_SCREENSHOT_QUALITY=55

# --- Storage ---
# Where conversation history is written.
# BROWSER_AGENT_STORE_DIR=~/.browser-agent
